# Upstage API Configuration
# Upstage 개발자 콘솔 (https://console.upstage.ai/)에서 발급받은 API 키를 입력하세요.
UPSTAGE_API_KEY=your_upstage_api_key_here

# 사용할 모델명 (기본: solar-pro)
UPSTAGE_MODEL=solar-pro

# API Base URL (Upstage Solar API 기본 경로)
UPSTAGE_BASE_URL=https://api.upstage.ai/v1

# 추론 강도 (solar-pro 지원: low, medium, high)
UPSTAGE_REASONING_EFFORT=medium
